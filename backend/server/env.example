# Copy to .env and fill in
PORT=5000
NODE_ENV=development

# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hyperlocal

# Use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# AI features (assistant, image product detection, voice search)
# Works with any OpenAI-compatible gateway: OpenAI, Groq, OpenRouter, Ollama...
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1
# Header used to send the key (Authorization for OpenAI-style, or e.g. Lovable-API-Key)
AI_KEY_HEADER=Authorization

# ---------------------------------------------------------------------------
# Google sign-in (Google Identity Services)
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# add http://localhost:8080 to "Authorized JavaScript origins", paste the ID here.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
