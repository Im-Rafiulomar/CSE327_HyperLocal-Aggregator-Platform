# Copy to .env and fill in
PORT=5000
NODE_ENV=development

# Local MongoDB or MongoDB Atlas connection string
# Atlas: Database > Connect > Drivers, then add your DB user password and
# insert the database name before the "?" — e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hyperlocal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hyperlocal

# Use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# AI features (assistant, image product detection, voice search)
# Works with any OpenAI-compatible gateway: OpenAI, Groq, OpenRouter, Ollama...
# For a Groq key (starts with "gsk_"), use Groq's endpoint + model names, NOT
# OpenAI's — the two are not interchangeable, mismatching them causes a
# confusing "Incorrect API key" 401 from whichever endpoint you pointed at.
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # Preview — vision-capable
#   AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1
# Header used to send the key (Authorization for OpenAI-style, or e.g. Lovable-API-Key)
AI_KEY_HEADER=Authorization

# ---------------------------------------------------------------------------
# Firebase Authentication
# Server-side (Admin SDK — verifies ID tokens): Firebase Console > Project
# settings > Service accounts > Generate new private key. Paste the three
# values from that JSON file below. FIREBASE_PRIVATE_KEY must keep its \n
# sequences literal (don't replace them with real line breaks in .env).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-side (Web SDK config, served to the browser via GET /api/auth/firebase/config):
# Firebase Console > Project settings > General > Your apps > SDK setup and
# configuration. These values are public/safe to expose — they are not secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
