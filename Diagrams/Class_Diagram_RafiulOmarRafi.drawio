    <mxGraphModel dx="2934" dy="1576" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class User {\n      +ObjectId id\n      +String name\n      +String email\n      +String phone\n      -String password\n      +String role\n      +String language\n      +String avatarEmoji\n      +Number coins\n      +Address[] addresses\n      +ObjectId[] wishlist\n      +String[] claimedCoupons\n      +NotificationPrefs notificationPrefs\n      +String[] refreshTokens\n      +comparePassword(candidate) Boolean\n      +toPublic() Object\n    }\n\n    class Address {\n      +String label\n      +String line1\n      +String area\n      +String city\n      +String postcode\n      +Boolean isDefault\n    }\n\n    class Seller {\n      +ObjectId id\n      +String slug\n      +String name\n      +String nameBn\n      +String area\n      +Number rating\n      +Boolean isLocal\n      +Boolean verified\n      +String since\n      +String responseTime\n    }\n\n    class Product {\n      +ObjectId id\n      +String slug\n      +String name\n      +String brand\n      +String category\n      +String image\n      +Number price\n      +Number oldPrice\n      +Number rating\n      +Number reviewCount\n      +String description\n      +Map specs\n      +String aiSummary\n      +String[] tags\n    }\n\n    class Offer {\n      +Number price\n      +String delivery\n      +Number stock\n    }\n\n    class Review {\n      +ObjectId id\n      +String authorName\n      +Number rating\n      +String text\n      +Boolean suspicious\n      +String reason\n      +Number trustScore\n    }\n\n    class Cart {\n      +ObjectId id\n      +CartItem[] items\n    }\n\n    class CartItem {\n      +Number qty\n    }\n\n    class Order {\n      +ObjectId id\n      +String code\n      +Number subtotal\n      +Number delivery\n      +Number coinsUsed\n      +Number discount\n      +Number total\n      +Number coinsEarned\n      +String paymentMethod\n      +String paymentStatus\n      +String status\n      +Address address\n      +TrackingStep[] tracking\n    }\n\n    class OrderItem {\n      +String name\n      +Number price\n      +Number qty\n    }\n\n    class TrackingStep {\n      +String label\n      +String labelBn\n      +Date at\n      +Boolean done\n    }\n\n    class Coupon {\n      +String code\n      +String title\n      +Number cost\n      +String type\n      +Number value\n    }\n\n    class Notification {\n      +String type\n      +String title\n      +String body\n      +Boolean read\n    }\n\n    class AuthService {\n      +register(dto)\n      +login(email, password)\n      +refresh(token)\n      +logout(token)\n      +signAccessToken(user)\n      +signRefreshToken(user)\n    }\n\n    class FakeReviewService {\n      +analyze(review) TrustResult\n    }\n\n    class RecommendationService {\n      +forUser(user) Product[]\n    }\n\n    class AssistantService {\n      +handle(message) AssistantReply\n      +visualSearch(labels) Product[]\n      +voiceSearch(transcript) Product[]\n    }\n\n    class ApiClient {\n      +auth\n      +products\n      +cart\n      +orders\n      +reviews\n      +rewards\n      +sellers\n      +ai\n    }\n\n    class AuthProvider {\n      +user\n      +login()\n      +register()\n      +logout()\n    }\n\n    User \&quot;1\&quot; o-- \&quot;0..*\&quot; Address : has\n    User \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Seller : owns\n    User \&quot;1\&quot; --&gt; \&quot;1\&quot; Cart : has\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order : places\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review : writes\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : receives\n    User \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Product : wishlist\n    User \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Coupon : claims\n\n    Product \&quot;1\&quot; o-- \&quot;0..*\&quot; Offer : offers\n    Offer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Seller : from\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review : has\n\n    Cart \&quot;1\&quot; o-- \&quot;0..*\&quot; CartItem\n    CartItem --&gt; Product\n    CartItem --&gt; Seller\n\n    Order \&quot;1\&quot; o-- \&quot;1..*\&quot; OrderItem\n    Order \&quot;1\&quot; o-- \&quot;0..*\&quot; TrackingStep\n    OrderItem --&gt; Product\n    OrderItem --&gt; Seller\n\n    AuthService --&gt; User\n    FakeReviewService --&gt; Review\n    RecommendationService --&gt; Product\n    AssistantService --&gt; Order\n    AssistantService --&gt; Product\n\n    AuthProvider --&gt; ApiClient\n    ApiClient --&gt; AuthService\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jjBANt4bNvJ-GJd8uj3A-1">
