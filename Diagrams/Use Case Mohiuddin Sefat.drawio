  <diagram id="desc-page" name="2. Detailed Use Case Description">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Detailed Use Case Description — Place Order &amp;amp; Make Payment" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontStyle=1;fontSize=18;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="1040" height="60" as="geometry" />
        </mxCell>
        <mxCell id="label0" value="&lt;b&gt;Use Case ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="125" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value0" value="UC-02" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="125" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="&lt;b&gt;Use Case Name&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="195" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value1" value="Place Order &amp; Make Payment" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="195" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="&lt;b&gt;Primary Actor&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="265" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value2" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="265" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label3" value="&lt;b&gt;Supporting Actors&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="335" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value3" value="Payment Gateway, Seller" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="335" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label4" value="&lt;b&gt;Goal&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="405" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value4" value="Complete checkout, choose a payment method, place the order, and receive confirmation." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="405" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label5" value="&lt;b&gt;Preconditions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="475" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="value5" value="1. Customer has selected at least one product or used Buy Now.&lt;br&gt;2. Product is available.&lt;br&gt;3. Checkout page is accessible." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="475" width="730" height="110" as="geometry" />
        </mxCell>
        <mxCell id="label6" value="&lt;b&gt;Trigger&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="585" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="value6" value="Customer proceeds to checkout and confirms the purchase." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="585" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="label7" value="&lt;b&gt;Main Success Flow&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="230" height="310" as="geometry" />
        </mxCell>
        <mxCell id="value7" value="1. System displays the order summary.&lt;br&gt;2. Customer enters delivery address and contact information.&lt;br&gt;3. System displays available payment methods.&lt;br&gt;4. Customer selects a payment method.&lt;br&gt;5. Customer may redeem available coins or rewards.&lt;br&gt;6. System recalculates the final payable amount.&lt;br&gt;7. Customer selects Place Order.&lt;br&gt;8. System creates a pending order.&lt;br&gt;9. System processes online payment through the Payment Gateway, or records COD.&lt;br&gt;10. Payment Gateway returns success for online payment.&lt;br&gt;11. System confirms the order and generates a unique order ID.&lt;br&gt;12. Seller receives the new-order notification.&lt;br&gt;13. System displays order confirmation.&lt;br&gt;14. Customer can continue to Track Order." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="655" width="730" height="310" as="geometry" />
        </mxCell>
        <mxCell id="label8" value="&lt;b&gt;Alternative / Exception Flows&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="965" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="value8" value="A1. Invalid address → system asks the customer to correct the information.&lt;br&gt;A2. Insufficient coins/wallet balance → system prevents invalid redemption.&lt;br&gt;A3. Online payment fails → customer can retry or choose another method.&lt;br&gt;A4. Product becomes unavailable → customer removes or replaces the item." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="965" width="730" height="140" as="geometry" />
        </mxCell>
        <mxCell id="label9" value="&lt;b&gt;Postconditions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1105" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="value9" value="&lt;b&gt;Success:&lt;/b&gt; Confirmed order with unique order ID is stored; payment status is recorded; seller receives notification; customer can track the order.&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; No confirmed paid order is created, or the order remains payment-pending." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="330" y="1105" width="730" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
