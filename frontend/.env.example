# Copy to .env and fill in

# Express + MongoDB API base URL
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Firebase Authentication (client SDK — Google sign-in popup, etc.)
# Firebase Console > Project settings > General > Your apps > SDK setup and
# configuration. These are public/safe to expose in the browser bundle.
#
# Optional: if left unset, the app fetches this same config at runtime from
# the API's GET /auth/firebase/config endpoint instead — set these only if
# you want it baked in at build time.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
